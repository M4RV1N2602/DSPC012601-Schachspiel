<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Schach.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
    <Application.Resources>
        <FontFamily x:Key="Merida">avares://Schach/Assets/chess_merida_unicode.ttf#Chess Merida Unicode</FontFamily>
    </Application.Resources>
</Application>
